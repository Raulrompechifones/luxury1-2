<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.luxury12.Controller.RegistroUsuarioController"
      alignment="CENTER"
      spacing="12"
      prefWidth="450"
      prefHeight="620"
      style="-fx-background-color: #172033;">

    <padding>
        <Insets top="25" right="45" bottom="25" left="45"/>
    </padding>

    <Label text="HOTEL LUXURY"
           style="-fx-font-size: 30px;
                  -fx-font-weight: bold;
                  -fx-text-fill: #D4AF37;"/>

    <Label text="REGISTRO DE USUARIO"
           style="-fx-font-size: 18px;
                  -fx-font-weight: bold;
                  -fx-text-fill: white;"/>

    <Label text="Complete sus datos para crear una cuenta"
           style="-fx-font-size: 12px;
                  -fx-text-fill: #CBD5E1;"/>

    <TextField fx:id="txtNombre"
               promptText="Nombre"
               prefHeight="38"/>

    <TextField fx:id="txtApellido"
               promptText="Apellido"
               prefHeight="38"/>

    <TextField fx:id="txtDni"
               promptText="DNI (8 dígitos)"
               prefHeight="38"/>

    <TextField fx:id="txtUsuario"
               promptText="Nombre de usuario"
               prefHeight="38"/>

    <PasswordField fx:id="txtClave"
                   promptText="Contraseña"
                   prefHeight="38"/>

    <PasswordField fx:id="txtConfirmarClave"
                   promptText="Confirmar contraseña"
                   prefHeight="38"/>

    <Label text="Rol asignado: RECEPCIONISTA"
           style="-fx-font-size: 13px;
                  -fx-text-fill: #D4AF37;"/>

    <Button text="CREAR CUENTA"
            onAction="#registrar"
            prefWidth="300"
            prefHeight="42"
            style="-fx-background-color: #D4AF37;
                   -fx-text-fill: #101820;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8;
                   -fx-cursor: hand;"/>

    <Button text="CANCELAR"
            onAction="#cancelar"
            prefWidth="300"
            prefHeight="40"
            style="-fx-background-color: transparent;
                   -fx-border-color: #D4AF37;
                   -fx-border-radius: 8;
                   -fx-text-fill: white;
                   -fx-cursor: hand;"/>

</VBox>