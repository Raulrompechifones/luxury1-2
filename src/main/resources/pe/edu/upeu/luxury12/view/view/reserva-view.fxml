<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.luxury12.Controller.ReservaController"
            prefWidth="1000"
            prefHeight="650"
            style="-fx-background-color: #F4F6F9;">

    <top>
        <VBox spacing="18" style="-fx-background-color: white;">
            <padding>
                <Insets top="25" right="30" bottom="22" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="▣"
                       style="-fx-font-size: 27px;
                              -fx-text-fill: #17365D;"/>

                <Label text="Reservas"
                       style="-fx-font-size: 25px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #17365D;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ Nueva Reserva"
                        onAction="#registrarReserva"
                        style="-fx-background-color: #17365D;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-font-size: 13px;
                               -fx-padding: 12 20;
                               -fx-background-radius: 6;"/>
            </HBox>

            <TextField promptText="⌕  Buscar por cliente o habitación..."
                       prefHeight="43"
                       maxWidth="Infinity"
                       style="-fx-background-color: white;
                              -fx-border-color: #DCE2EA;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-padding: 10;
                              -fx-font-size: 13px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="15"
              style="-fx-background-color: #F4F6F9;">
            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <TableView fx:id="tablaReservas"
                       VBox.vgrow="ALWAYS"
                       prefHeight="480"
                       style="-fx-background-color: white;
                              -fx-border-color: #E0E5EB;
                              -fx-border-radius: 8;
                              -fx-background-radius: 8;">

                <columns>

                    <TableColumn fx:id="colId"
                                 text="N°"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colCliente"
                                 text="CLIENTE"
                                 prefWidth="230"/>

                    <TableColumn fx:id="colHabitacion"
                                 text="HABITACIÓN"
                                 prefWidth="170"/>

                    <TableColumn fx:id="colIngreso"
                                 text="FECHA INGRESO"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colSalida"
                                 text="FECHA SALIDA"
                                 prefWidth="200"/>

                    <TableColumn fx:id="colTotal"
                                 text="TOTAL (S/)"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colEstado"
                                 text="ESTADO"
                                 prefWidth="170"/>

                </columns>

                <placeholder>
                    <Label text="No hay reservas registradas"
                           style="-fx-font-size: 14px;
                                  -fx-text-fill: #7B8794;"/>
                </placeholder>

            </TableView>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="ACTUALIZAR"
                        onAction="#actualizarReservas"
                        style="-fx-background-color: #2874A6;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="EDITAR"
                        onAction="#editarReserva"
                        style="-fx-background-color: #D9A441;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="ELIMINAR"
                        onAction="#eliminarReserva"
                        style="-fx-background-color: #C0392B;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
