<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.luxury12.Controller.HabitacionController"
            prefWidth="950"
            prefHeight="600"
            style="-fx-background-color: #F5F6FA;">

    <children>

        <Label text="GESTIÓN DE HABITACIONES"
               layoutX="30"
               layoutY="25"
               style="-fx-font-size: 25px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1B263B;"/>

        <Label text="Administración de habitaciones - HOTEL LUXURY"
               layoutX="30"
               layoutY="65"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #666666;"/>

        <HBox layoutX="30"
              layoutY="110"
              spacing="12">

            <children>

                <Button text="REGISTRAR"
                        onAction="#registrarHabitacion"
                        prefWidth="125"
                        style="-fx-background-color: #198754;
                               -fx-text-fill: white;"/>

                <Button text="EDITAR"
                        onAction="#editarHabitacion"
                        prefWidth="125"
                        style="-fx-background-color: #0D6EFD;
                               -fx-text-fill: white;"/>

                <Button text="ELIMINAR"
                        onAction="#eliminarHabitacion"
                        prefWidth="125"
                        style="-fx-background-color: #DC3545;
                               -fx-text-fill: white;"/>

                <Button text="ACTUALIZAR"
                        prefWidth="125"
                        onAction="#actualizarHabitaciones"
                        style="-fx-background-color: #D4AF37;
                               -fx-text-fill: black;"/>

            </children>
        </HBox>

        <TableView fx:id="tablaHabitaciones"
                   layoutX="30"
                   layoutY="175"
                   prefWidth="890"
                   prefHeight="380">

            <columns>

                <TableColumn fx:id="colId"
                             text="ID"
                             prefWidth="65"/>

                <TableColumn fx:id="colCodigo"
                             text="CÓDIGO"
                             prefWidth="140"/>

                <TableColumn fx:id="colNumero"
                             text="NÚMERO"
                             prefWidth="120"/>

                <TableColumn fx:id="colTipo"
                             text="TIPO"
                             prefWidth="150"/>

                <TableColumn fx:id="colPrecio"
                             text="PRECIO"
                             prefWidth="140"/>

                <TableColumn fx:id="colEstado"
                             text="ESTADO"
                             prefWidth="270"/>

            </columns>
        </TableView>

    </children>
</AnchorPane>
