<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.luxury12.Controller.HabitacionController"
            prefWidth="1000"
            prefHeight="650"
            style="-fx-background-color: #F4F6F9;">

    <top>
        <VBox spacing="15" style="-fx-background-color: white;">
            <padding>
                <Insets top="22" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="GESTIÓN DE HABITACIONES"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #172B4D;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar"
                           promptText="Buscar habitación..."
                           prefWidth="300"
                           onAction="#buscarHabitacion"
                           style="-fx-background-radius: 6;
                                  -fx-border-radius: 6;
                                  -fx-border-color: #D5DCE5;
                                  -fx-padding: 10;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ REGISTRAR"
                        onAction="#registrarHabitacion"
                        style="-fx-background-color: #17365D;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="EDITAR"
                        onAction="#editarHabitacion"
                        style="-fx-background-color: #D9A441;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="ELIMINAR"
                        onAction="#eliminarHabitacion"
                        style="-fx-background-color: #C0392B;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="ACTUALIZAR"
                        onAction="#actualizarHabitaciones"
                        style="-fx-background-color: #2874A6;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="12" style="-fx-background-color: #F4F6F9;">
            <padding>
                <Insets top="20" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="Listado de habitaciones"
                   style="-fx-font-size: 17px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #263A53;"/>

            <TableView fx:id="tablaHabitaciones"
                       VBox.vgrow="ALWAYS"
                       prefHeight="480"
                       style="-fx-background-color: white;
                              -fx-border-color: #DCE2EA;
                              -fx-border-radius: 6;">

                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="110"/>

                    <TableColumn fx:id="colCodigo"
                                 text="CÓDIGO"
                                 prefWidth="290"/>

                    <TableColumn fx:id="colNumero"
                                 text="NÚMERO"
                                 prefWidth="270"/>

                    <TableColumn fx:id="colTipo"
                                 text="TIPO"
                                 prefWidth="310"/>

                    <TableColumn fx:id="colPrecio"
                                 text="PRECIO (S/)"
                                 prefWidth="290"/>

                    <TableColumn fx:id="colEstado"
                                 text="ESTADO"
                                 prefWidth="290"/>
                </columns>

                <placeholder>
                    <Label text="No hay habitaciones registradas"
                           style="-fx-text-fill: #7B8794;
                                  -fx-font-size: 14px;"/>
                </placeholder>

            </TableView>
        </VBox>
    </center>

</BorderPane>
