<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="pe.edu.upeu.luxury12.Controller.PortadaController"
      prefWidth="1000"
      prefHeight="650"
      style="-fx-background-color: #071827;">

    <!-- PANEL IZQUIERDO -->
    <VBox prefWidth="420"
          alignment="CENTER"
          spacing="16"
          style="-fx-background-color: #071827;
                 -fx-padding: 45;">

        <Label text="♛"
               style="-fx-font-size: 55px;
                      -fx-text-fill: #D4AF37;"/>

        <Label text="HOTEL LUXURY"
               style="-fx-font-family: Georgia;
                      -fx-font-size: 34px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #D4AF37;"/>

        <Label text="SISTEMA DE GESTIÓN HOTELERA"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #FFFFFF;"/>

        <Region prefHeight="30"/>

        <Label text="BIENVENIDO"
               style="-fx-font-size: 22px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <Label text="Inicia sesión para continuar"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #A8B8C8;"/>

        <Region prefHeight="10"/>

        <!-- USUARIO -->
        <Label text="USUARIO"
               maxWidth="310"
               style="-fx-text-fill: #D4AF37;
                      -fx-font-size: 12px;
                      -fx-font-weight: bold;"/>

        <TextField fx:id="txtUsuario"
                   promptText="Ingrese su usuario"
                   prefWidth="310"
                   maxWidth="310"
                   prefHeight="45"
                   style="-fx-background-color: #10283C;
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #A8B8C8;
                          -fx-border-color: #476174;
                          -fx-border-radius: 7;
                          -fx-background-radius: 7;
                          -fx-font-size: 14px;"/>

        <!-- CONTRASEÑA -->
        <Label text="CONTRASEÑA"
               maxWidth="310"
               style="-fx-text-fill: #D4AF37;
                      -fx-font-size: 12px;
                      -fx-font-weight: bold;"/>

        <PasswordField fx:id="txtClave"
                       promptText="Ingrese su contraseña"
                       prefWidth="310"
                       maxWidth="310"
                       prefHeight="45"
                       style="-fx-background-color: #10283C;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #A8B8C8;
                              -fx-border-color: #476174;
                              -fx-border-radius: 7;
                              -fx-background-radius: 7;
                              -fx-font-size: 14px;"/>

        <Region prefHeight="12"/>

        <!-- INICIAR SESIÓN -->
        <Button text="INICIAR SESIÓN"
                onAction="#iniciarSesion"
                prefWidth="310"
                prefHeight="47"
                style="-fx-background-color: #D4AF37;
                       -fx-text-fill: #071827;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 8;
                       -fx-cursor: hand;"/>

        <Label text="¿No tienes una cuenta?"
               style="-fx-font-size: 13px;
                      -fx-text-fill: #A8B8C8;"/>

        <!-- REGISTRAR USUARIO -->
        <Button text="REGISTRAR USUARIO"
                onAction="#registrarUsuario"
                prefWidth="310"
                prefHeight="43"
                style="-fx-background-color: transparent;
                       -fx-border-color: #D4AF37;
                       -fx-border-width: 1.5;
                       -fx-border-radius: 8;
                       -fx-text-fill: #D4AF37;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-cursor: hand;"/>

        <Region prefHeight="15"/>

        <Label text="© HOTEL LUXURY"
               style="-fx-font-size: 11px;
                      -fx-text-fill: #758797;"/>

    </VBox>

    <!-- PANEL DERECHO: IMAGEN DEL HOTEL -->
    <StackPane prefWidth="580"
               style="-fx-background-color: #101820;">

        <ImageView fitWidth="580"
                   fitHeight="650"
                   preserveRatio="false">
            <image>
                <Image url="@../img/hotel_portada.png"/>
            </image>
        </ImageView>

        <VBox alignment="BOTTOM_CENTER"
              mouseTransparent="true"
              style="-fx-padding: 35;">

            <Label text="HOTEL LUXURY"
                   style="-fx-font-family: Georgia;
                          -fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #D4AF37;
                          -fx-effect: dropshadow(gaussian, black, 8, 0.7, 1, 2);"/>

            <Label text="Una experiencia de lujo"
                   style="-fx-font-size: 16px;
                          -fx-text-fill: white;
                          -fx-effect: dropshadow(gaussian, black, 6, 0.8, 1, 2);"/>
        </VBox>

    </StackPane>

</HBox>
