<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>


<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.luxury12.Controller.MainController"
            prefWidth="1220"
            prefHeight="780"
            minWidth="900"
            minHeight="600"
            style="-fx-background-color: #F5F6F8;">

    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="12"
              prefHeight="58"
              minHeight="58"
              style="-fx-background-color: #0D1E2B; -fx-padding: 0 22 0 22;">

            <Label text="♛"
                   style="-fx-font-size: 27px; -fx-text-fill: #D8B66A;"/>

            <VBox spacing="1">
                <Label text="HOTEL LUXURY"
                       style="-fx-font-family: Georgia; -fx-font-size: 19px; -fx-font-weight: bold; -fx-text-fill: #E2C477;"/>
                <Label text="SISTEMA DE GESTIÓN HOTELERA"
                       style="-fx-font-size: 9px; -fx-text-fill: #DCE2E8;"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <Label text="●"
                   style="-fx-font-size: 15px; -fx-text-fill: #D8B66A;"/>

            <VBox spacing="1" alignment="CENTER_RIGHT">
                <Label fx:id="lblUsuarioActual"
                       text="Usuario"
                       style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="lblRolActual"
                       text="Rol"
                       style="-fx-font-size: 10px; -fx-text-fill: #D8B66A;"/>
            </VBox>

        </HBox>
    </top>

    <left>
        <VBox prefWidth="190"
              minWidth="190"
              spacing="9"
              alignment="TOP_CENTER"
              style="-fx-background-color: #0D1E2B; -fx-padding: 22 12 15 12;">

            <Label text="MENÚ PRINCIPAL"
                   maxWidth="Infinity"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #8999A7; -fx-padding: 5 8 12 8;"/>

            <Button text="⌂    Inicio"
                    onAction="#mostrarInicio"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: #80632D; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-background-radius: 5; -fx-cursor: hand;"/>

            <Button text="♟    Clientes"
                    onAction="#mostrarClientes"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Button text="▣    Habitaciones"
                    onAction="#mostrarHabitaciones"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Button text="▦    Reservas"
                    onAction="#mostrarReservas"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Button fx:id="btnUsuarios"
                    text="♟    Usuarios"
                    onAction="#mostrarUsuarios"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Button fx:id="btnReportes"
                    text="▥    Reportes"
                    onAction="#mostrarReportes"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="⏻    Cerrar sesión"
                    onAction="#cerrarSesion"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: #172C3B; -fx-text-fill: white; -fx-font-size: 12px; -fx-alignment: CENTER_LEFT; -fx-background-radius: 5; -fx-cursor: hand;"/>

        </VBox>
    </left>

    <center>
        <StackPane fx:id="panelContenido"
                   alignment="CENTER"
                   style="-fx-background-color: #F5F6F8; -fx-padding: 25;">

            <Label text="BIENVENIDO AL SISTEMA HOTEL LUXURY"
                   wrapText="true"
                   alignment="CENTER"
                   maxWidth="Infinity"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #172B3A;"/>

        </StackPane>
    </center>

</BorderPane>
