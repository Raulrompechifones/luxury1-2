<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.luxury12.Controller.MainController"
            prefWidth="1200"
            prefHeight="750"
            style="-fx-background-color: #F5F7FA;">

    <!-- MENÚ LATERAL -->
    <left>
        <VBox prefWidth="235"
              spacing="12"
              style="-fx-background-color: #071827;
                     -fx-padding: 20;">

            <!-- LOGOTIPO -->
            <VBox alignment="CENTER"
                  spacing="5"
                  style="-fx-padding: 10 0 25 0;">

                <Label text="♛"
                       style="-fx-font-size: 40px;
                              -fx-text-fill: #D4AF37;"/>

                <Label text="HOTEL LUXURY"
                       style="-fx-font-family: Georgia;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-text-fill: #D4AF37;"/>

                <Label text="GESTIÓN HOTELERA"
                       style="-fx-font-size: 11px;
                              -fx-text-fill: #A8B8C8;"/>
            </VBox>

            <!-- NAVEGACIÓN -->
            <Button text="⌂   INICIO"
                    onAction="#mostrarInicio"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: #D4AF37;
                           -fx-text-fill: #071827;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

            <Button text="♟   CLIENTES"
                    onAction="#mostrarClientes"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"/>

            <Button text="▣   HABITACIONES"
                    onAction="#mostrarHabitaciones"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"/>

            <Button text="▦   RESERVAS"
                    onAction="#mostrarReservas"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnUsuarios"
                    text="♟   USUARIOS"
                    onAction="#mostrarUsuarios"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnReportes"
                    text="▥   REPORTES"
                    onAction="#mostrarReportes"
                    maxWidth="Infinity"
                    prefHeight="43"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-alignment: CENTER_LEFT;
                           -fx-cursor: hand;"/>

            <!-- ESPACIO FLEXIBLE -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- CERRAR SESIÓN -->
            <Button text="⏻   CERRAR SESIÓN"
                    onAction="#cerrarSesion"
                    maxWidth="Infinity"
                    prefHeight="45"
                    style="-fx-background-color: #10283C;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 8;
                           -fx-cursor: hand;"/>

        </VBox>
    </left>

    <!-- PARTE CENTRAL Y CABECERA -->
    <center>
        <BorderPane>

            <!-- BARRA SUPERIOR -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="15"
                      prefHeight="65"
                      style="-fx-background-color: #071827;
                             -fx-padding: 10 25;">

                    <Label text="HOTEL LUXURY"
                           style="-fx-font-size: 17px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #D4AF37;"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <VBox alignment="CENTER_RIGHT"
                          spacing="3">

                        <Label fx:id="lblUsuarioActual"
                               text="Usuario"
                               style="-fx-font-size: 14px;
                                      -fx-font-weight: bold;
                                      -fx-text-fill: white;"/>

                        <Label fx:id="lblRolActual"
                               text="Rol"
                               style="-fx-font-size: 11px;
                                      -fx-text-fill: #D4AF37;"/>
                    </VBox>

                </HBox>
            </top>

            <!-- CONTENIDO DE LOS MÓDULOS -->
            <center>
                <StackPane fx:id="panelContenido"
                           alignment="CENTER"
                           style="-fx-background-color: #F5F7FA;">

                    <Label text="BIENVENIDO A HOTEL LUXURY"
                           style="-fx-font-size: 25px;
                                  -fx-font-weight: bold;
                                  -fx-text-fill: #071827;"/>

                </StackPane>
            </center>

        </BorderPane>
    </center>

</BorderPane>
