<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.luxury12.Controller.ClienteController"
      stylesheets="@styles.css"
      spacing="20" style="-fx-background-color: #F4F6F9; -fx-padding: 25;">

    <VBox spacing="18" VBox.vgrow="ALWAYS" styleClass="tarjeta-blanca">

        <HBox alignment="CENTER_LEFT" spacing="12">
            <Label text="👥" style="-fx-font-size: 24px; -fx-text-fill: #10263B;"/>
            <Label text="Clientes" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #10263B;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="+ Nuevo Cliente" onAction="#registrarCliente" styleClass="btn-primario-oscuro"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" styleClass="caja-busqueda">
            <TextField fx:id="txtBuscar" promptText="Buscar por DNI, nombre o apellido..."
                       onAction="#buscarCliente" HBox.hgrow="ALWAYS" styleClass="campo-busqueda"/>
            <Label text="🔍" style="-fx-padding: 0 14 0 0; -fx-text-fill: #64748B;"/>
        </HBox>

        <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS"
                   style="-fx-border-color: #E2E8F0; -fx-border-radius: 8;">
            <columns>
                <TableColumn fx:id="colId" text="N°" prefWidth="60" style="-fx-alignment: CENTER;"/>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="120" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="170" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colApellido" text="Apellido" prefWidth="170" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="130" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colEmail" text="Correo" prefWidth="210" style="-fx-alignment: CENTER_LEFT;"/>
                <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="110" style="-fx-alignment: CENTER;"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_RIGHT" spacing="6">
            <Button text="&lt;" styleClass="btn-paginacion"/>
            <Button text="1" styleClass="btn-paginacion-activa"/>
            <Button text="2" styleClass="btn-paginacion"/>
            <Button text="&gt;" styleClass="btn-paginacion"/>
        </HBox>

    </VBox>
</VBox>