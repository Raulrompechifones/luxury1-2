<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.luxury12.Controller.ClienteController"
            prefWidth="1000"
            prefHeight="650"
            style="-fx-background-color: #F4F6F9;">

    <top>
        <VBox spacing="15" style="-fx-background-color: white;">
            <padding>
                <Insets top="22" right="25" bottom="18" left="25"/>
            </padding>

            <Label text="GESTIÓN DE CLIENTES"
                   style="-fx-font-size: 23px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #172B4D;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">

                <TextField fx:id="txtBuscar"
                           promptText="Buscar cliente..."
                           prefWidth="300"
                           onAction="#buscarCliente"
                           style="-fx-background-radius: 6;
                                  -fx-border-radius: 6;
                                  -fx-border-color: #D5DCE5;
                                  -fx-padding: 10;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ REGISTRAR"
                        onAction="#registrarCliente"
                        style="-fx-background-color: #17365D;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="EDITAR"
                        onAction="#editarCliente"
                        style="-fx-background-color: #D9A441;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="ELIMINAR"
                        onAction="#eliminarCliente"
                        style="-fx-background-color: #C0392B;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>

                <Button text="ACTUALIZAR"
                        onAction="#actualizarClientes"
                        style="-fx-background-color: #2874A6;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 10 18;
                               -fx-background-radius: 5;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="12"
              style="-fx-background-color: #F4F6F9;">

            <padding>
                <Insets top="20" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="Listado de clientes"
                   style="-fx-font-size: 17px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #263A53;"/>

            <TableView fx:id="tablaClientes"
                       VBox.vgrow="ALWAYS"
                       prefHeight="480"
                       style="-fx-background-color: white;
                              -fx-border-color: #DCE2EA;
                              -fx-border-radius: 6;">

                <columns>

                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="90"/>

                    <TableColumn fx:id="colNombre"
                                 text="NOMBRES"
                                 prefWidth="220"/>

                    <TableColumn fx:id="colApellido"
                                 text="APELLIDOS"
                                 prefWidth="240"/>

                    <TableColumn fx:id="colDni"
                                 text="DNI"
                                 prefWidth="140"/>

                    <TableColumn fx:id="colTelefono"
                                 text="TELÉFONO"
                                 prefWidth="170"/>

                    <TableColumn fx:id="colEmail"
                                 text="CORREO ELECTRÓNICO"
                                 prefWidth="410"/>

                    <TableColumn fx:id="colPersonas"
                                 text="PERSONAS"
                                 prefWidth="200"/>

                </columns>

                <placeholder>
                    <Label text="No hay clientes registrados"
                           style="-fx-text-fill: #7B8794;
                                  -fx-font-size: 14px;"/>
                </placeholder>

            </TableView>
        </VBox>
    </center>

</BorderPane>
