<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="pe.edu.upeu.luxury12.Controller.UsuarioController"
            style="-fx-background-color: #F3F5F9;">

    <top>
        <VBox spacing="8"
              style="-fx-background-color: #172033;">

            <padding>
                <Insets top="25" right="30" bottom="25" left="30"/>
            </padding>

            <Label text="HOTEL LUXURY - USUARIOS"
                   style="-fx-font-size: 24px;
                          -fx-font-weight: bold;
                          -fx-text-fill: white;"/>

            <Label text="Administración de cuentas del personal"
                   style="-fx-font-size: 13px;
                          -fx-text-fill: #CBD5E1;"/>

        </VBox>
    </top>

    <center>
        <VBox spacing="20">

            <padding>
                <Insets top="30" right="25" bottom="25" left="25"/>
            </padding>

            <Label text="USUARIOS REGISTRADOS"
                   style="-fx-font-size: 18px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #172033;"/>

            <TableView fx:id="tablaUsuarios"
                       VBox.vgrow="ALWAYS"
                       prefHeight="350">

                <columns>
                    <TableColumn fx:id="colId"
                                 text="ID"
                                 prefWidth="55"/>

                    <TableColumn fx:id="colNombre"
                                 text="NOMBRE"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colApellido"
                                 text="APELLIDO"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colDni"
                                 text="DNI"
                                 prefWidth="100"/>

                    <TableColumn fx:id="colUsuario"
                                 text="USUARIO"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colRol"
                                 text="ROL"
                                 prefWidth="140"/>
                    <TableColumn fx:id="colEstado"
                                 text="ESTADO"
                                 prefWidth="110"/>
                </columns>

            </TableView>

            <HBox spacing="12">

                <Button text="REGISTRAR"
                        onAction="#registrarUsuario"
                        style="-fx-background-color: #16A34A;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;"
                        prefHeight="40"/>

                <Button text="EDITAR"
                        onAction="#editarUsuario"
                        style="-fx-background-color: #2563EB;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;"
                        prefHeight="40"/>

                <Button text="ELIMINAR"
                        onAction="#eliminarUsuario"
                        style="-fx-background-color: #C0392B;
                               -fx-text-fill: white;
                                -fx-font-weight: bold;
                               -fx-background-radius: 8;"
                        prefHeight="40"/>


                <Button text="ACTUALIZAR"
                        onAction="#listarUsuarios"
                        style="-fx-background-color: #172033;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 8;"
                        prefHeight="40"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>